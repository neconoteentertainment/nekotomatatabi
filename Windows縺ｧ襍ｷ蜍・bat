@echo off
setlocal
cd /d "%~dp0"

echo ==========================================
echo   Nekotomatatabi - Windows Launcher
echo ==========================================
echo.

where flutter >nul 2>nul
if errorlevel 1 (
  echo [ERROR] Flutter was not found in PATH.
  pause
  exit /b 1
)

if not exist "windows\CMakeLists.txt" (
  echo [ERROR] Bundled Windows project is missing.
  echo Please use the newest ZIP and extract it to a new folder.
  pause
  exit /b 1
)

echo [1/4] Enable Windows desktop support...
call flutter config --enable-windows-desktop
if errorlevel 1 goto :error

echo [2/4] Get packages...
call flutter pub get
if errorlevel 1 goto :error

echo [3/4] Check Windows toolchain...
call flutter doctor -v

echo [4/4] Launch on Windows...
call flutter run -d windows
if errorlevel 1 goto :error
exit /b 0

:error
echo.
echo ==========================================
echo Launch failed. Please send the FIRST error shown above.
echo ==========================================
pause
exit /b 1
